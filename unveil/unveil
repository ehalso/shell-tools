#!/usr/bin/env bash
# unveil — muestra y copia al portapapeles un secreto de Infisical. SOLO PARA HUMANOS:
# se niega a correr si la salida no es un terminal real, para que ni Claude Code ni
# ningún script lo use por error y vuelque un valor al chat o a un log.
#
#   unveil NOMBRE [CARPETA]     busca NOMBRE (en CARPETA, o en cualquier carpeta si es única)
#   unveil ls [CARPETA]         lista nombres y carpetas (nunca valores)
#   --no-copy                   solo muestra      --no-show   solo copia (no imprime)
#   --env ENTORNO               default prod      --project NOMBRE   default Estebanalcocer.cloud
# El valor nunca va en argumentos (ni en ps ni en el historial): solo viaja por pipes.
# Copia con OSC52 (llega al portapapeles de TU terminal local aunque estés por SSH, y
# atraviesa tmux), y además con wl-copy/xclip/pbcopy si existen. No limpia el portapapeles.
set -u
ENV_=prod; PROJ="Estebanalcocer.cloud"; COPY=1; SHOW=1; LS=0; ARGS=()
while (($#)); do
  case $1 in
    --no-copy) COPY=0;; --no-show) SHOW=0;;
    --env) ENV_=${2:?falta valor}; shift;; --project) PROJ=${2:?falta valor}; shift;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    ls) [ ${#ARGS[@]} -eq 0 ] && LS=1 || ARGS+=("$1");;
    *) ARGS+=("$1");;
  esac; shift
done
if [ ! -t 1 ] || [ ! -t 2 ]; then
  echo "unveil: la salida no es un terminal; no imprimo secretos hacia pipes, logs o agentes." >&2; exit 2
fi
[ -f ~/.config/infisical/.env ] && source ~/.config/infisical/.env
command -v infisical >/dev/null && command -v jq >/dev/null || { echo "unveil: faltan infisical o jq" >&2; exit 1; }
PID=$(jq -r --arg n "$PROJ" '.[]|select(.name==$n)|.projectId' ~/.config/infisical/projects.json 2>/dev/null)
[ -n "$PID" ] || { echo "unveil: proyecto '$PROJ' no está en ~/.config/infisical/projects.json (corre refresh-projects.sh)" >&2; exit 1; }

# El CLI (-o json) no devuelve la carpeta de cada secreto, así que se lee la API REST (sí trae
# secretPath en modo recursivo). El token se pasa por stdin a curl (-K -), no por argv: no sale en ps.
# El listado viaja por pipe/variable; los valores no se imprimen salvo el elegido.
[ -n "${INFISICAL_TOKEN:-}" ] && [ -n "${INFISICAL_API_URL:-}" ] || { echo "unveil: faltan INFISICAL_TOKEN/INFISICAL_API_URL (~/.config/infisical/.env)" >&2; exit 1; }
ALL=$(printf 'header = "Authorization: Bearer %s"\nheader = "User-Agent: curl/8.5.0"\n' "$INFISICAL_TOKEN" \
  | curl -sf -K - --get "${INFISICAL_API_URL%/}/v3/secrets/raw" \
      --data-urlencode "workspaceId=$PID" --data-urlencode "environment=$ENV_" \
      --data-urlencode "secretPath=/" --data-urlencode "recursive=true" \
  | jq -c '[.secrets[]|{secretKey,secretValue,secretPath}]') \
  || { echo "unveil: no pude leer Infisical (¿token vencido o sin red?)" >&2; exit 1; }
norm() { local p=/${1#/}; p=${p%/}; echo "${p:-/}"; }

if [ "$LS" = 1 ]; then
  want=""; [ -n "${ARGS[0]:-}" ] && want=$(norm "${ARGS[0]}")
  echo "$ALL" | jq -r --arg w "$want" '.[]|(.secretPath // "/") as $p|select($w=="" or $p==$w)|"\($p)\t\(.secretKey)"' | sort
  exit 0
fi
NAME=${ARGS[0]:-}; [ -n "$NAME" ] || { echo "uso: unveil NOMBRE [CARPETA] | unveil ls [CARPETA]" >&2; exit 1; }
FOLDER=""; [ -n "${ARGS[1]:-}" ] && FOLDER=$(norm "${ARGS[1]}")
MATCHES=$(echo "$ALL" | jq -r --arg n "$NAME" --arg f "$FOLDER" '.[]|(.secretPath // "/") as $p|select(.secretKey==$n and ($f=="" or $p==$f))|$p')
COUNT=$(printf '%s' "$MATCHES" | grep -c .)
if [ "$COUNT" = 0 ]; then echo "unveil: '$NAME' no existe${FOLDER:+ en $FOLDER} ($PROJ/$ENV_)" >&2; exit 1; fi
if [ "$COUNT" -gt 1 ]; then
  echo "unveil: '$NAME' está en varias carpetas; indica una:" >&2; printf '  %s\n' $MATCHES >&2; exit 1
fi
VALUE=$(echo "$ALL" | jq -r --arg n "$NAME" --arg p "$MATCHES" '.[]|select(.secretKey==$n and ((.secretPath // "/")==$p))|.secretValue')
unset ALL

[ "$SHOW" = 1 ] && printf '%s\n' "$VALUE"
if [ "$COPY" = 1 ]; then
  b64=$(printf '%s' "$VALUE" | base64 -w0 2>/dev/null || printf '%s' "$VALUE" | base64)
  if [ -n "${TMUX:-}" ]; then printf '\033Ptmux;\033\033]52;c;%s\a\033\\' "$b64" >/dev/tty
  else printf '\033]52;c;%s\a' "$b64" >/dev/tty; fi
  for c in "wl-copy" "xclip -selection clipboard" "pbcopy"; do
    command -v "${c%% *}" >/dev/null && { printf '%s' "$VALUE" | $c 2>/dev/null; break; }
  done
  echo "unveil: $NAME ($MATCHES) copiado al portapapeles" >&2
fi
